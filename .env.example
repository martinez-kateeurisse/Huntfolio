# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Phase 4: AI resume-tailoring (server-side only; never exposed to client) ---
# Uses OpenRouter (OpenAI-compatible). Get a key at https://openrouter.ai/keys.
# Required only for the "Tailor to this job" feature.
OPENROUTER_API_KEY=
# Optional — pin a model. Defaults to the free auto-router (openrouter/free).
# Examples: deepseek/deepseek-chat-v3-0324:free, google/gemma-3-27b-it:free
OPENROUTER_MODEL=openrouter/free

# --- Optional: weekly email digest of "Needs attention" (not built by default) ---
RESEND_API_KEY=

# --- Optional: server timezone (defaults to Asia/Manila) ---
# Vercel runs in UTC; the app uses this so "today", "overdue", and dates match
# your clock. Any IANA zone name works, e.g. America/New_York.
APP_TIMEZONE=Asia/Manila

# --- Optional: protects the daily keep-alive cron (/api/health) ---
# If set in Vercel, Vercel sends it automatically on cron calls.
CRON_SECRET=
